\newlabel{fig_rep_template_exchange}{{R6}{16}{\responsefiguretitle {fig_rep_template_exchange}{Change in lexical metrics and ThyClinScore after exchanging clause templates between the SMU-HMC and revised KMVE libraries. Each bar is the decrease of a metric after the exchange, that is, its value with the original templates minus its value with the exchanged templates named in the panel title. Error bars: 95\% CIs from a paired bootstrap over reports (10,000 resamples). Values are given in Supplementary Table~\SuppTabSwap {}.}\relax }{figure.caption.23}{}}

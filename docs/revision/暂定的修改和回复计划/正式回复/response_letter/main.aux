\@writefile{lof}{\contentsline {figure}{\numberline {R7}{\ignorespaces Figure\nobreakspace  {}R7.\nobreakspace  Reader study results by physician. \textbf  {a}, Annotation consistency, that is, agreement of the diagnostic direction of the report with the annotation-derived case label; error bars, 95\% Wilson CIs; values above the bars, AI-assisted minus manual, in percentage points; ***p < 0.001, McNemar's test over the 145 cases paired by case (the differences for each physician compare different cases and were not tested). n, cases read manually/with AI assistance. \textbf  {b}, Under-calls: cases labelled malignant or suspicious that were reported as benign. \textbf  {c}, Over-calls: benign cases reported as malignant or suspicious. Numbers above the bars in \textbf  {b} and \textbf  {c}, cases with the error/cases with the label.\relax }}{18}{figure.caption.25}\protected@file@percent }
\newlabel{fig_rep_reader_by_physician}{{R7}{18}{\responsefiguretitle {fig_rep_reader_by_physician}{Reader study results by physician. \textbf {a}, Annotation consistency, that is, agreement of the diagnostic direction of the report with the annotation-derived case label; error bars, 95\% Wilson CIs; values above the bars, AI-assisted minus manual, in percentage points; ***p < 0.001, McNemar's test over the 145 cases paired by case (the differences for each physician compare different cases and were not tested). n, cases read manually/with AI assistance. \textbf {b}, Under-calls: cases labelled malignant or suspicious that were reported as benign. \textbf {c}, Over-calls: benign cases reported as malignant or suspicious. Numbers above the bars in \textbf {b} and \textbf {c}, cases with the error/cases with the label.}\relax }{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {R8}{\ignorespaces Figure\nobreakspace  {}R8.\nobreakspace  Safety study (70 videos; 35 per physician). \textbf  {a}, Sentences of the draft changed by the physician, by the mark of the sentence; bars, both physicians; symbols, each physician; n, sentences. Changes include added descriptions and rewording. \textbf  {b}, Consistency of the diagnostic direction with two references: the annotation-derived case labels (70 cases) and the physician-confirmed findings, that is, the benign or malignant tendency of each nodule recorded by physicians 3 and 4 during review (67 cases; 3 with an ambiguous direction excluded). AI draft, the drafts reviewed in this study; manual and AI-assisted, the reports of physicians 1 and 2 in the reader study (Figure\nobreakspace  {}\ref  {fig_rep_reader_by_physician}); AI-assisted (safety rules), the final reports of physicians 3 and 4, who reviewed the drafts marked by the safety rules. \dag  {}The physician-confirmed findings were recorded by physicians 3 and 4, who also wrote these reports. \textbf  {c}, Review time per case; boxes, median and interquartile range; whiskers, 1.5 times the interquartile range; triangles, cases longer than 8 min, plotted at 8 min.\relax }}{19}{figure.caption.26}\protected@file@percent }
\newlabel{fig_rep_safety_study}{{R8}{19}{\responsefiguretitle {fig_rep_safety_study}{Safety study (70 videos; 35 per physician). \textbf {a}, Sentences of the draft changed by the physician, by the mark of the sentence; bars, both physicians; symbols, each physician; n, sentences. Changes include added descriptions and rewording. \textbf {b}, Consistency of the diagnostic direction with two references: the annotation-derived case labels (70 cases) and the physician-confirmed findings, that is, the benign or malignant tendency of each nodule recorded by physicians 3 and 4 during review (67 cases; 3 with an ambiguous direction excluded). AI draft, the drafts reviewed in this study; manual and AI-assisted, the reports of physicians 1 and 2 in the reader study (\responsefigureref {fig_rep_reader_by_physician}); AI-assisted (safety rules), the final reports of physicians 3 and 4, who reviewed the drafts marked by the safety rules. \dag {}The physician-confirmed findings were recorded by physicians 3 and 4, who also wrote these reports. \textbf {c}, Review time per case; boxes, median and interquartile range; whiskers, 1.5 times the interquartile range; triangles, cases longer than 8 min, plotted at 8 min.}\relax }{figure.caption.26}{}}

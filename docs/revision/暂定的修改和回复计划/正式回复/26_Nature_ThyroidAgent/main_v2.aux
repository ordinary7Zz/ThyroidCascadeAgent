\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Composition and data splits of the multicentre thyroid ultrasound benchmark. Numbers and percentages show the images contributed by each dataset to the full benchmark (n=37{,}713) and to the training (n=18{,}277), validation (n=850) and test (n=18{,}586) cohorts. DDTI and RJH-7K are independent external test cohorts, and ZJH-8K is a same-centre institutional hold-out test cohort of 6{,}807 images (1{,}068 patients) collected at the hospital that contributed TN3K. DDTI comprises 637 images, of which 349 carry benign-malignant classification labels. ZJH-8K serves as a test set for segmentation and classification; its malignant primary-lesion images additionally provide the development and hold-out sets for malignant-lesion stratification (4{,}028 images, 647 patients; Supplementary Table~\ref  {tab:Malignant_images_tasks_performance}).\relax }}{32}{table.caption.15}\protected@file@percent }
\newlabel{tab:dataset_summary}{{S1}{32}{Composition and data splits of the multicentre thyroid ultrasound benchmark. Numbers and percentages show the images contributed by each dataset to the full benchmark (n=37{,}713) and to the training (n=18{,}277), validation (n=850) and test (n=18{,}586) cohorts. DDTI and RJH-7K are independent external test cohorts, and ZJH-8K is a same-centre institutional hold-out test cohort of 6{,}807 images (1{,}068 patients) collected at the hospital that contributed TN3K. DDTI comprises 637 images, of which 349 carry benign-malignant classification labels. ZJH-8K serves as a test set for segmentation and classification; its malignant primary-lesion images additionally provide the development and hold-out sets for malignant-lesion stratification (4{,}028 images, 647 patients; Supplementary Table~\ref {tab:Malignant_images_tasks_performance}).\relax }{table.caption.15}{}}
\newlabel{tab:dataset_summary@cref}{{[table][1][]S1}{[1][32][]32}}

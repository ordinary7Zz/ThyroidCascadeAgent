\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figure\nobreakspace  {}R1.\nobreakspace  External-test malignancy reliability diagrams for the official test splits of five pathology-labelled cohorts (TN3K, TN5K, ThyroidXL, ZJH-8K, DDTI), shown side by side; models were developed on each cohort's train/validation partitions and evaluated on test. ZJH-8K sample size: Table\nobreakspace  {}\ref  {tab_dhash}. Referral uses vote entropy, top-2 margin, and minimum pairwise segmentation IoU with OR combination; thresholds were fit on the pooled validation set, frozen, and applied on test without retuning.\relax }}{16}{figure.caption.8}\protected@file@percent }
\newlabel{fig_reliability}{{1}{16}{\responsefiguretitle {fig_reliability}{External-test malignancy reliability diagrams for the official test splits of five pathology-labelled cohorts (TN3K, TN5K, ThyroidXL, ZJH-8K, DDTI), shown side by side; models were developed on each cohort's train/validation partitions and evaluated on test. ZJH-8K sample size: \responsetableref {tab_dhash}. Referral uses vote entropy, top-2 margin, and minimum pairwise segmentation IoU with OR combination; thresholds were fit on the pooled validation set, frozen, and applied on test without retuning.}\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Figure\nobreakspace  {}R2.\nobreakspace  Risk--coverage curves for the official test splits of five pathology-labelled cohorts (TN3K, TN5K, ThyroidXL, ZJH-8K, DDTI), shown side by side; ThyroidXAgent was developed on each cohort's train/validation partitions and evaluated on test. Horizontal axis: classification uncertainty from vote entropy, top-2 malignancy-probability margin, and minimum pairwise segmentation IoU (OR combination; same definitions as Table\nobreakspace  {}\ref  {tab_calib_referral}). Vertical axis: coverage (non-referred fraction). Referral thresholds were fit on the pooled OpenThyroid validation set ($n{=}875$), frozen for all cohorts, and applied on test without retuning; curve operating points match referral rates in Table\nobreakspace  {}\ref  {tab_calib_referral}. ZJH-8K sample size: Table\nobreakspace  {}\ref  {tab_dhash}.\relax }}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig_risk_coverage}{{2}{17}{\responsefiguretitle {fig_risk_coverage}{Risk--coverage curves for the official test splits of five pathology-labelled cohorts (TN3K, TN5K, ThyroidXL, ZJH-8K, DDTI), shown side by side; ThyroidXAgent was developed on each cohort's train/validation partitions and evaluated on test. Horizontal axis: classification uncertainty from vote entropy, top-2 malignancy-probability margin, and minimum pairwise segmentation IoU (OR combination; same definitions as \responsetableref {tab_calib_referral}). Vertical axis: coverage (non-referred fraction). Referral thresholds were fit on the pooled OpenThyroid validation set ($n{=}875$), frozen for all cohorts, and applied on test without retuning; curve operating points match referral rates in \responsetableref {tab_calib_referral}. ZJH-8K sample size: \responsetableref {tab_dhash}.}\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Figure\nobreakspace  {}R3.\nobreakspace  Image-analysis data flow. Left: development pools for main tasks (segmentation and benign--malignant classification) and malignant subtasks (LNM, PTC subtype). Centre: shared image-analysis pipeline (DINO experts, PyRadiomics/AutoGluon tabular expert, validation-fitted routing, and routed segmentation masks and classification labels). Right: independent external-test cohorts and the dual role of ZJH-8K (generic external test versus LNM/PTC-subtype development).\relax }}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig_image_dataflow}{{3}{17}{\responsefiguretitle {fig_image_dataflow}{Image-analysis data flow. Left: development pools for main tasks (segmentation and benign--malignant classification) and malignant subtasks (LNM, PTC subtype). Centre: shared image-analysis pipeline (DINO experts, PyRadiomics/AutoGluon tabular expert, validation-fitted routing, and routed segmentation masks and classification labels). Right: independent external-test cohorts and the dual role of ZJH-8K (generic external test versus LNM/PTC-subtype development).}\relax }{figure.caption.10}{}}
